<h1>Log In</h1>

<%= form_with url: login_path do |f| %>
  <p>
    <%= f.label :email %><br>
    <%= f.email_field :email, autofocus: true %>
  </p>
  <p>
    <%= f.label :password %><br>
    <%= f.password_field :password %>
  </p>
  <p><%= f.submit "Log In" %></p>
<% end %>

<p>Don't have an account? <%= link_to "Sign up", sign_up_path %></p>
