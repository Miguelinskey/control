<%= render "admin/shared/nav" %>

<h1>Admin: Users</h1>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Banned?</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><%= user.role.titleize %></td>
        <td><%= user.banned? ? "Yes" : "No" %></td>
        <td>
          <%= link_to "Edit", edit_admin_user_path(user) %>
          <%= button_to "Delete", admin_user_path(user), method: :delete, data: { confirm: "Delete user '#{user.username}'?" }, class: "btn-inline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

