<%= render "admin/shared/nav" %>

<h1>Admin: Categories</h1>

<p><%= link_to "New Category", new_admin_category_path %></p>

<table>
  <thead>
    <tr>
      <th>Position</th>
      <th>Name</th>
      <th>Slug</th>
      <th>Topics</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.position %></td>
        <td><%= category.name %></td>
        <td><%= category.slug %></td>
        <td><%= category.topics_count %></td>
        <td>
          <%= link_to "Edit", edit_admin_category_path(category) %>
          <%= button_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Delete category '#{category.name}'?" }, class: "btn-inline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

