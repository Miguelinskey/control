<%= render "shared/errors", object: category %>

<%= form_with model: [:admin, category] do |f| %>
  <p>
    <%= f.label :name %><br>
    <%= f.text_field :name, autofocus: true %>
  </p>
  <p>
    <%= f.label :slug %><br>
    <%= f.text_field :slug %>
  </p>
  <p>
    <%= f.label :description %><br>
    <%= f.text_area :description, rows: 3, cols: 60 %>
  </p>
  <p>
    <%= f.label :position %><br>
    <%= f.number_field :position %>
  </p>
  <p><%= f.submit %></p>
<% end %>
