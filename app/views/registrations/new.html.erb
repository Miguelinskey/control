<h1>Sign Up</h1>

<%= render "shared/errors", object: @user %>

<%= form_with model: @user, url: sign_up_path do |f| %>
  <div class="hp-field">
    <%= label_tag :website, "Website" %><br>
    <%= text_field_tag :website %>
  </div>
  <p data-controller="username-check" data-username-check-url-value="<%= users_check_username_path %>">
    <%= f.label :username %><br>
    <%= f.text_field :username, autofocus: true,
        data: { username_check_target: "input", action: "input->username-check#check" } %>
    <span data-username-check-target="feedback" class="username-feedback"></span>
  </p>
  <p>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= f.label :password %><br>
    <%= f.password_field :password %>
  </p>
  <p>
    <%= f.label :password_confirmation %><br>
    <%= f.password_field :password_confirmation %>
  </p>
  <p><%= f.submit "Sign Up" %></p>
<% end %>

<p>Already have an account? <%= link_to "Log in", login_path %></p>
