<!DOCTYPE html>
<html>
  <head>
    <title>Control</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <style>
      body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 10px; }
      nav { background: #333; color: #fff; padding: 8px 12px; margin-bottom: 16px; }
      nav a { color: #fff; margin-right: 12px; }
      .flash-notice { color: green; }
      .flash-alert { color: red; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
      th { background: #eee; }
      .hp-field { position: absolute; left: -9999px; }
    </style>
  </head>
  <body>
    <nav>
      <%= link_to "Forum", root_path %>
      <% if logged_in? %>
        <span>Logged in as <strong><%= current_user.username %></strong>
        <% if current_user.admin? %>(admin) <%= link_to "Admin", admin_categories_path %><% end %></span>
        <%= button_to "Logout", logout_path, method: :delete, style: "display:inline; background:none; border:none; color:#fff; cursor:pointer; text-decoration:underline; font-size:inherit;" %>
      <% else %>
        <%= link_to "Log in", login_path %>
        <%= link_to "Sign up", sign_up_path %>
      <% end %>
    </nav>

    <% if flash[:notice] %>
      <p class="flash-notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p class="flash-alert"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
