<!DOCTYPE html>
<html>
  <head>
    <title>Control</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav>
      <%= link_to "Forum", root_path %>
      <% if logged_in? %>
        <span><%= identicon_tag(current_user.username) %> Logged in as <strong><%= current_user.username %></strong>
        <% if current_user.admin? %>(admin) <%= link_to "Admin", admin_root_path %><% end %>
        <% if current_user.moderator? %>(mod)<% end %></span>
        <%= button_to "Logout", logout_path, method: :delete, class: "btn-link" %>
      <% else %>
        <%= link_to "Log in", login_path %>
        <%= link_to "Sign up", sign_up_path %>
      <% end %>
    </nav>

    <% if flash[:notice] %>
      <p class="flash-notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p class="flash-alert"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
