<h1>Edit User: <%= @user.username %></h1>

<%= form_with model: [:admin, @user] do |f| %>
  <p>
    <%= f.check_box :admin %>
    <%= f.label :admin, "Administrator" %>
  </p>
  <p>
    <%= f.check_box :banned %>
    <%= f.label :banned, "Banned" %>
  </p>
  <p><%= f.submit "Update User" %></p>
<% end %>

<p><%= link_to "Back", admin_users_path %></p>
