<h1><%= @topic.title %></h1>
<p>
  in <%= link_to @category.name, category_path(@category) %>
  <% if @topic.pinned? %>&mdash; <strong>[PINNED]</strong><% end %>
  <% if @topic.locked? %>&mdash; <strong>[LOCKED]</strong><% end %>
</p>

<% if @posts.first_page? %>
  <div class="post-card">
    <p>
      <%= identicon_tag(@topic.user.username) %> <strong><%= @topic.user.username %></strong>
      &mdash; <%= time_ago_in_words(@topic.created_at) %> ago
    </p>
    <div><%= format_post_body(@topic.body) %></div>
    <p>
      <% if logged_in? && !@topic.locked? %>
        <span data-controller="quote" data-quote-username-value="<%= @topic.user.username %>" data-quote-body-value="<%= @topic.body %>">
          <a href="#" data-action="click->quote#insert">Quote</a>
        </span>
      <% end %>
      <% if @topic.authored_by?(current_user) %>
        <%= link_to "Edit", edit_category_topic_path(@category, @topic) %>
      <% end %>
      <% if @topic.authored_by?(current_user) || current_user&.staff? %>
        <%= button_to "Delete", category_topic_path(@category, @topic), method: :delete, data: { confirm: "Are you sure?" } %>
      <% end %>
      <% if current_user&.staff? %>
        <%= button_to(@topic.locked? ? "Unlock" : "Lock", lock_category_topic_path(@category, @topic), method: :patch) %>
        <%= button_to(@topic.pinned? ? "Unpin" : "Pin", pin_category_topic_path(@category, @topic), method: :patch) %>
      <% end %>
    </p>
  </div>
<% end %>

<% @posts.each do |post| %>
  <div class="post-card" id="post-<%= post.id %>">
    <p>
      <%= identicon_tag(post.user.username) %> <strong><%= post.user.username %></strong>
      &mdash; <%= time_ago_in_words(post.created_at) %> ago
    </p>
    <div><%= format_post_body(post.body) %></div>
    <p>
      <% if logged_in? && !@topic.locked? %>
        <span data-controller="quote" data-quote-username-value="<%= post.user.username %>" data-quote-body-value="<%= post.body %>">
          <a href="#" data-action="click->quote#insert">Quote</a>
        </span>
      <% end %>
      <% if post.authored_by?(current_user) %>
        <%= link_to "Edit", edit_category_topic_post_path(@category, @topic, post) %>
      <% end %>
      <% if post.authored_by?(current_user) || current_user&.staff? %>
        <%= button_to "Delete", category_topic_post_path(@category, @topic, post), method: :delete %>
      <% end %>
    </p>
  </div>
<% end %>

<%= paginate @posts %>

<% unless @topic.locked? %>
  <% if logged_in? %>
    <h3>Reply</h3>
    <%= render "posts/form", post: @post, category: @category, topic: @topic %>
  <% end %>
<% else %>
  <p><em>This topic is locked. No new replies.</em></p>
<% end %>

<p><%= link_to "Back to #{@category.name}", category_path(@category) %></p>
